{
  "name": "rujira-connect-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --config packages/extension/vite.config.ts",
    "dev:example": "vite --config packages/example/vite.config.ts",
    "build": "pnpm build:libs && pnpm build:extension && pnpm build:example",
    "build:libs": "tsup --config tsup.config.ts",
    "build:extension": "vite build --config packages/extension/vite.config.ts && tsx scripts/build-extension.ts",
    "build:example": "vite build --config packages/example/vite.config.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:hardware": "vitest run --config vitest.hardware.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build:icons": "tsx scripts/build-icons.ts",
    "build:store-assets": "tsx scripts/build-store-assets.ts",
    "build:monero": "tsx scripts/build-monero-kernel.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@ledgerhq/hw-transport-mocker": "6.35.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@trezor/protobuf": "10.0.1",
    "@trezor/protocol": "10.0.1",
    "@types/chrome": "^0.1.27",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^5.0.3"
  }
}
